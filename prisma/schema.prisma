// VOL-program — datamodel
// Multi-skool van die begin af: Skool → Projek → Groep.
// Werkboeke self (werkblaaie, kriteria, kontrolepunte) is weergawe-sjablone in kode
// (lib/werkboeke); 'n Projek verwys daarna met templateKey.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  motto     String?
  createdAt DateTime  @default(now())
  teachers  Teacher[]
  projects  Project[]
  aiReports AiReport[]
  aiEvalCases AiEvalCase[]
  pdfComparisons PdfComparison[]
  aiRules AiRule[]
}

enum TeacherRole {
  DEVELOPER
  ADMIN
  TEACHER
}

model Teacher {
  id           String      @id @default(cuid())
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email        String      @unique
  name         String
  passwordHash String
  role         TeacherRole @default(TEACHER)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  lastLoginAt  DateTime?

  @@index([schoolId])
}

model Project {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  templateKey String
  title       String
  grade       Int
  year        Int
  phenomenon  String
  question    String
  partner     String?
  // Fases met datums (oorskryf sjabloon se verstek), sien lib/werkboeke/tipes.ts → Phase[]
  schedule    Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  groups      Group[]

  @@index([schoolId, active])
}

model Group {
  id          String              @id @default(cuid())
  projectId   String
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String              @unique
  klas        String?
  name        String?
  // Voorname van lede (maks 4). Word NOOIT na die KI gestuur nie.
  members     Json                @default("[]")
  archived    Boolean             @default(false)
  // Ingelees uit ’n papierwerkboek: afgetekende werkblaaie bly bewerkbaar.
  paperImport Boolean             @default(false)
  createdAt   DateTime            @default(now())
  lastSeenAt  DateTime?
  responses   Response[]
  versions    ResponseVersion[]
  feedback    Feedback[]
  checkpoints Checkpoint[]
  photos      Photo[]
  aiReports   AiReport[]

  @@index([projectId, archived])
}

enum SheetStatus {
  NOT_STARTED
  IN_PROGRESS
  NOT_READY
  READY
}

model Response {
  id           String      @id @default(cuid())
  groupId      String
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Werkblad-sleutel, bv. "ws3" of "ws15:2" (per-lid werkblaaie)
  sheet        String
  data         Json        @default("{}")
  revision     Int         @default(0)
  status       SheetStatus @default(NOT_STARTED)
  // Hash van data toe dit "gereed" verklaar is; verander die data, val die status terug.
  readyHash    String?
  readyBy      String?
  // Onderwyser-velde (bv. kommentaar by die veiligheidsplan): { [veld]: { text, by, at } }
  teacherNotes Json        @default("{}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([groupId, sheet])
}

model ResponseVersion {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sheet     String
  revision  Int
  data      Json
  // "outostoor" | "terugvoer" | "ingedien" | "goedgekeur"
  reason    String
  createdAt DateTime @default(now())

  @@index([groupId, sheet, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sheet     String
  revision  Int
  ready     Boolean
  // Gestruktureerde resultaat, sien lib/ki/tipes.ts → FeedbackResult
  result    Json
  // "gpt-…" | "toetsmodus" | "volledigheid"
  source    String
  // Weergawe van die KI-opdrag waarmee hierdie antwoord gemaak is.
  promptVer String   @default("v1")
  sheetVer  Int      @default(1)
  // Bevrore, geanonimiseerde invoer waarmee die KI-antwoord gemaak is.
  inputSnapshot Json?
  createdAt DateTime @default(now())
  aiReports AiReport[]
  votes     FeedbackVote[]

  @@index([groupId, sheet, createdAt])
  @@index([groupId, createdAt])
}

enum CheckpointStatus {
  OPEN
  SUBMITTED
  APPROVED
  RETURNED
}

model Checkpoint {
  id          String           @id @default(cuid())
  groupId     String
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  number      Int
  status      CheckpointStatus @default(OPEN)
  submittedAt DateTime?
  decidedAt   DateTime?
  teacherId   String?
  teacherName String?
  comment     String?
  history     Json             @default("[]")
  updatedAt   DateTime         @updatedAt

  @@unique([groupId, number])
  @@index([status])
}

model Photo {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sheet     String
  field     String
  mime      String
  size      Int
  width     Int?
  height    Int?
  caption   String?
  // "db" (bytes hieronder) of "s3" (storageKey in die bucket)
  storage   String   @default("db")
  storageKey String?
  bytes     Bytes?
  createdAt DateTime @default(now())

  @@index([groupId, sheet, field])
}

// Eenvoudige, veelvuldige-instansie-veilige tempo-beperking.
model RateEvent {
  id        BigInt   @id @default(autoincrement())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

// Terugvoer van onderwysers aan die ontwikkelaar: oor die KI-terugvoer of die program self.
// Word gebruik om die KI-opdrag en kriteria by te stel. Uitvoer as CSV via /api/terugvoer.
model DevFeedback {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  schoolId    String
  teacherId   String?
  teacherName String
  // "ki" (oor ’n spesifieke KI-terugvoer) | "algemeen"
  kind        String
  // "reg" | "te_streng" | "te_sag" | "verkeerd" | "fout" | "voorstel" | "vraag" | "ander"
  rating      String?
  message     String
  page        String?
  groupId     String?
  sheet       String?
  feedbackId  String?
  criterionId String?
  // Gestruktureerde verduideliking van wat verkeerd is en hoe wyd 'n aanpassing moet geld.
  issueType      String?
  expectedVerdict String?
  scope          String?
  // "nuut" | "gelees" | "verwerk"
  status      String   @default("nuut")
  // Interne nota is net vir die ontwikkelaar; antwoord is vir die onderwyser sigbaar.
  devNote     String?
  developerReply String?
  respondedAt DateTime?
  // "nie" | "beplan" | "bygevoeg" – spoor permanente regressietoetse.
  regressionStatus String @default("nie")

  @@index([schoolId, createdAt])
  @@index([teacherId, createdAt])
  @@index([status])
}

// 'n Leerdergroep kan 'n onveilige, verkeerde of onvanpaste KI-antwoord rapporteer.
// Geen leerdernaam word gestoor nie; konteks word via die groep, werkblad en KI-antwoord gekoppel.
model AiReport {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sheet      String
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  category   String
  message    String
  // "nuut" | "gelees" | "verwerk"
  status     String   @default("nuut")
  devNote    String?
  resolution String?
  resolvedAt DateTime?

  @@index([schoolId, status, createdAt])
  @@index([groupId, sheet, createdAt])
  @@unique([groupId, feedbackId])
}

// Herhaalbare, werklike KI-toets wat uit goedgekeurde onderwyserterugvoer ontstaan.
model AiEvalCase {
  id                  String   @id @default(cuid())
  schoolId            String
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sourceDevFeedbackId String   @unique
  createdBy           String
  title               String
  templateKey         String
  sheet               String
  input               Json
  criterionId         String
  expectedVerdict     String
  active              Boolean  @default(true)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastRunAt           DateTime?
  lastPassed          Boolean?
  lastSummary         String?
  lastResult          Json?

  @@index([schoolId, active])
  @@index([lastPassed])
}

// ---------------------------------------------------------------- PDF-vergelyking
// ’n Onderwyser laai ’n gescande papierwerkboek op. OpenAI lees leerder- en
// onderwyserhandskrif apart uit; ná akkoord kry die leerders se antwoorde die gewone
// KI-terugvoer, wat dan langs die onderwyser se eie kommentaar gewys word.
model PdfComparison {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId   String
  teacherName String
  projectId   String
  // Opsioneel: die groep in die app waaraan hierdie papierwerkboek behoort.
  groupId     String?
  templateKey String
  fileName    String
  // Die PDF self; word geskrap sodra die onderwyser die uitlees goedkeur.
  pdf         Bytes?
  // "uitlees" | "nagaan" | "ki" | "klaar" | "fout"
  status      String    @default("uitlees")
  error       String?
  extracted   Json?
  results     Json?
  model       String?
  votes       PdfVote[]

  @@index([schoolId, teacherId, createdAt])
  @@index([groupId])
}

model PdfVote {
  id           String        @id @default(cuid())
  comparisonId String
  comparison   PdfComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  sheet        String
  criterionId  String
  teacherId    String
  // 1 = duim op, -1 = duim af
  vote         Int
  // By duim af: die onderwyser se rede en die gesprek met die KI ([{ van, teks, at }])
  reason       String?
  chat         Json?
  ruleId       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([comparisonId, sheet, criterionId, teacherId])
}

// 👍/👎 van ’n onderwyser op ’n KI-oordeel in die app (per kriterium), met die gesprek ná ’n duim af.
model FeedbackVote {
  id          String   @id @default(cuid())
  feedbackId  String
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  groupId     String
  sheet       String
  criterionId String
  teacherId   String
  vote        Int
  reason      String?
  chat        Json?
  ruleId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([feedbackId, criterionId, teacherId])
  @@index([groupId])
}

// Reëls wat onderwysers by die KI-terugvoer voeg (bv. uit ’n gesprek ná ’n duim af).
// Aktiewe reëls gaan dadelik saam met elke KI-beoordeling van daardie werkboek/werkblad.
model AiRule {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  templateKey        String
  // null = geld vir die hele werkboek
  sheet              String?
  criterionId        String?
  text               String
  createdById        String
  createdByName      String
  active             Boolean  @default(true)
  sourceComparisonId String?
  // Sagte skrap: kan herstel word; die geskiedenis bly altyd.
  deletedAt          DateTime?
  events             AiRuleEvent[]

  @@index([schoolId, templateKey, active])
}

// Ouditspoor: elke handeling op ’n reël (wie, wat, wanneer, ou/nuwe teks).
model AiRuleEvent {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  ruleId   String
  rule     AiRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  schoolId String
  byId     String
  byName   String
  // "aangemaak" | "gewysig" | "afgeskakel" | "aangeskakel" | "geskrap" | "herstel" | "teruggedraai"
  action   String
  oldText  String?
  newText  String?
  note     String?
  // Nagegaan deur ’n administrateur (handelinge van admins self is outomaties nagegaan)
  reviewedAt     DateTime?
  reviewedByName String?

  @@index([schoolId, at])
  @@index([ruleId, at])
}

// Ouditlog van alles wat onderwysers doen (aanmeld, aftekening, kommentaar, PDF, duimpies, bestuur…).
// KI-reëlhandelinge staan apart in AiRuleEvent en word op die aktiwiteitsbladsy saamgevoeg.
model TeacherActivity {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  schoolId    String
  teacherId   String
  teacherName String
  type        String
  summary     String
  link        String?
  details     Json?

  @@index([schoolId, at])
  @@index([teacherId, at])
}
