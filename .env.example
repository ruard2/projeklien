# --- Databasis ---
# Plaaslik (npm run db): postgresql://vol:vol@localhost:5439/vol
# Railway: verwys na die Postgres-diens se DATABASE_URL
DATABASE_URL="postgresql://vol:vol@localhost:5439/vol"

# --- Sessies --- (minstens 32 ewekansige karakters; verpligtend in produksie)
SESSION_SECRET=""

# --- KI-terugvoer (OpenAI) --- Sonder sleutel loop die program in toetsmodus.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
# Slegs vir gpt-5-/o-modelle: minimal | low | medium | high
OPENAI_REASONING_EFFORT="medium"
# Tempo-beperking op terugvoer
FEEDBACK_MIN_SECONDS=20
FEEDBACK_PER_HOUR=40

# --- Foto-berging --- Leeg = in die databasis. Stel vir ’n S3-versoenbare bucket:
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Eerste opstelling (npm run seed) ---
SEED_ADMIN_EMAIL="admin@dirkpostma.test"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrateur"
# 1 = skep toetsgroepe G8-TEST88 en G9-TEST99
SEED_DEMO=0
